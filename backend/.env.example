# Copy to backend/.env and fill in. Never commit real values.
ZIVOO_ENV=development
ZIVOO_DATABASE_URL=postgresql+psycopg://zivoo:CHANGE_ME@localhost:5432/zivoo

# Parent auth. development: dev_hs256 (local only). staging/production: jwks.
ZIVOO_AUTH_MODE=dev_hs256
ZIVOO_DEV_JWT_SECRET=CHANGE_ME_local_only_at_least_32_characters

# Supabase Auth (or any OIDC provider exposing JWKS) for staging/production:
# ZIVOO_AUTH_MODE=jwks
# ZIVOO_AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# ZIVOO_AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
# ZIVOO_AUTH_AUDIENCE=authenticated

ZIVOO_CLAIM_TTL_SECONDS=600
ZIVOO_DEVICE_OFFLINE_AFTER_SECONDS=120
